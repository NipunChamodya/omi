# Server only. Copy to apps/server/.env. Never put credentials in VITE_ variables.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_PATH=./data/omi.sqlite

# Explicit development-only guest mode. Rejected in production.
ALLOW_GUESTS=false

# Configure all three together. Register this exact callback with Google.
# GOOGLE_CLIENT_ID=your-web-client-id
# GOOGLE_CLIENT_SECRET=your-server-only-secret
# GOOGLE_CALLBACK_URL=http://127.0.0.1:5173/api/auth/google/callback

# Optional private S3-compatible bucket. Uploads disabled without a bucket.
# AVATAR_BUCKET=omi-avatars
AVATAR_REGION=us-east-1
# AVATAR_ENDPOINT=https://your-s3-compatible-endpoint.example
# Credentials use the AWS SDK default chain (prefer workload roles in hosting).
# AWS_ACCESS_KEY_ID=your-server-only-key
# AWS_SECRET_ACCESS_KEY=your-server-only-secret
