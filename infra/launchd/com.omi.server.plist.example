<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.omi.server</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PATH/TO/NODE22/bin/node</string>
    <string>/ABSOLUTE/PATH/TO/OMI/apps/server/dist/index.js</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/TO/OMI/apps/server</string>
  <key>EnvironmentVariables</key><dict><key>NODE_ENV</key><string>production</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>/PRIVATE/RUNTIME/omi-server.log</string>
  <key>StandardErrorPath</key><string>/PRIVATE/RUNTIME/omi-server-error.log</string>
</dict></plist>
