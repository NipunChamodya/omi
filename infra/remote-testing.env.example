# Existing Google credentials remain ONLY in apps/server/.env.
# Do not source this file. Optional shell variables for startup:
# PORT=3000                 existing backend config; must be free
# OMI_NGINX_PORT=8080       loopback NGINX entry point; unprivileged and free
# DATABASE_PATH=./data/omi.sqlite  resolves relative to apps/server
# TRUST_LOCAL_PROXY=true   forced by the supervisor for its loopback backend
# NODE_ENV=production      forced by supervisor
# ALLOW_GUESTS=false        forced; preflight refuses true
# APP_ORIGIN and GOOGLE_CALLBACK_URL are derived from the actual issued URL.
# VITE_API_URL is derived as that URL plus /api during the build.
