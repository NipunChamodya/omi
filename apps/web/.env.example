# Public API base only; never place credentials/secrets in VITE_ variables.
# Default /api uses Vite's development proxy; production needs a reverse proxy.
VITE_API_URL=/api
# Optional development-only backend target, read by vite.config.ts (not shipped to the browser).
API_PROXY_TARGET=http://127.0.0.1:3000

# Optional opening-only first-party text sponsor. Empty by default.
# Supply both public values only after approving the advertiser and placement.
VITE_OMI_SPONSOR_LABEL=
VITE_OMI_SPONSOR_URL=
